{
  "name": "jukebox-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Aplicativo desktop da Jukebox",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable --x64",
    "dist:linux": "electron-builder --linux AppImage --x64"
  },
  "devDependencies": {
    "electron": "37.2.6",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "site.r777b.jukebox.desktop",
    "productName": "Jukebox",
    "asar": true,
    "files": [
      "main.js",
      "error.html",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Jukebox-Windows-${version}.exe"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "category": "AudioVideo",
      "artifactName": "Jukebox-Linux-${version}.AppImage"
    }
  }
}
