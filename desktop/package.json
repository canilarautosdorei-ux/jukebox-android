{
  "name": "kiosk-webview-linux",
  "version": "1.5.2",
  "private": true,
  "description": "kiosk Linux com WebView embutido, recuperação WebGL e sessão limpa a cada abertura",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "site.r777b.kiosk.webview",
    "productName": "kiosk WebView",
    "asar": true,
    "files": [
      "main.js",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Canil Arautos do Rei <canilarautosdorei@gmail.com>"
    }
  },
  "homepage": "https://kiosk.r777b.site",
  "author": {
    "name": "Canil Arautos do Rei",
    "email": "canilarautosdorei@gmail.com"
  }
}
