{
  "name": "jukebox-desktop",
  "version": "1.2.0",
  "private": true,
  "description": "Jukebox desktop launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:win": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "site.r777b.jukebox",
    "productName": "Jukebox",
    "asar": true,
    "files": ["main.js", "package.json"],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "AudioVideo"
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
